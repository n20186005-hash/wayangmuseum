---
import { paths, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<footer class="site-footer"><div><strong>Museum Wayang · Jakarta</strong><p>{locale === 'id' ? 'Panduan independen tanpa afiliasi dengan museum atau pemerintah. Tidak menyediakan akun, pemesanan, tiket atau formulir kontak.' : 'Independent guide with no museum or government affiliation. No accounts, bookings, tickets or contact form are provided.'}</p><p>{locale === 'id' ? 'Sumber diperiksa 29 Oktober 2026. Foto arsip mengikuti lisensi masing-masing sumber.' : 'Sources checked 29 October 2026. Archival photographs follow their individual source licences.'}</p></div><nav aria-label={locale === 'id' ? 'Dokumen situs' : 'Site documents'}><a href={paths.privacy[locale]}>{locale === 'id' ? 'Kebijakan Privasi' : 'Privacy Policy'}</a><a href={paths.terms[locale]}>{locale === 'id' ? 'Ketentuan Layanan' : 'Terms of Use'}</a><a href={paths.cookies[locale]}>{locale === 'id' ? 'Pengaturan Cookie' : 'Cookie Settings'}</a><a href={`${paths.home[locale]}#sumber`}>{locale === 'id' ? 'Sumber & kredit foto' : 'Sources & photo credits'}</a></nav></footer>
