---
import TopicLayout from '../layouts/TopicLayout.astro';
import { type Locale } from '../data/site';
import { type TopicContent, topicsId, topicsEn } from '../data/topics';

interface Props { content: TopicContent; locale: Locale; hasEn: boolean; }
const { content, locale, hasEn } = Astro.props;
const c = content;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const homeHref = locale === 'id' ? '/' : '/en/';
const siteUrl = Astro.site!.href.replace(/\/$/, '');
const aboutId = `${siteUrl}#museum`;

// Related link target respecting locale availability.
function relatedHref(slug: string): string {
  if (locale === 'en' && slug in topicsEn) return `/en/${slug}/`;
  return `/${slug}/`;
}
const relatedItems = c.related.filter(s => locale === 'en' ? (s in topicsEn || s in topicsId) : s in topicsId);
const relatedLinks = relatedItems.map(slug => {
  const t = locale === 'en' ? (topicsEn[slug] ?? topicsId[slug]) : topicsId[slug];
  return { href: relatedHref(slug), title: t.h1 };
});

const sources = c.sources ?? [];

const altHref = hasEn
  ? (locale === 'id' ? `/en/${c.slug}/` : `/${c.slug}/`)
  : (locale === 'id' ? '/en/' : '/');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      'url': canonical,
      'name': c.title,
      'description': c.description,
      'inLanguage': locale === 'id' ? 'id-ID' : 'en',
      'isPartOf': { '@id': `${siteUrl}#website` },
      'about': { '@id': aboutId },
      'breadcrumb': { '@id': `${canonical}#breadcrumb` }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': locale === 'id' ? 'Beranda' : 'Home', 'item': new URL(homeHref, Astro.site).href },
        { '@type': 'ListItem', 'position': 2, 'name': c.h1, 'item': canonical }
      ]
    },
    {
      '@type': 'FAQPage',
      'mainEntity': c.faq.map(f => ({ '@type': 'Question', 'name': f.q, 'acceptedAnswer': { '@type': 'Answer', 'text': f.a } }))
    }
  ]
};
---
<TopicLayout title={c.title} description={c.description} locale={locale} slug={c.slug} hasEn={hasEn} altHref={altHref}>
<main id="konten"><article class="topic">
  <nav class="breadcrumb wrap" aria-label={locale === 'id' ? 'Breadcrumb' : 'Breadcrumb'}>
    <a href={homeHref}>{locale === 'id' ? 'Beranda' : 'Home'}</a><span aria-hidden="true"> › </span><span>{c.h1}</span>
  </nav>
  <section class="section hero-topic"><div class="wrap">
    <p class="eyebrow">{locale === 'id' ? 'Panduan Museum Wayang' : 'Wayang Museum Guide'}</p>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    <p class="updated">{locale === 'id' ? 'Diperiksa' : 'Checked'} {c.updated}</p>
  </div></section>
  {c.sections.map(sec => (
    <section id={sec.id} class="section"><div class="wrap">
      <h2>{sec.heading}</h2>
      {sec.paragraphs && sec.paragraphs.map(p => <p>{p}</p>)}
      {sec.bullets && <ul class="bullets">{sec.bullets.map(b => <li>{b}</li>)}</ul>}
    </div></section>
  ))}
  <section id="tanya" class="section soft"><div class="wrap">
    <h2>{locale === 'id' ? 'Tanya jawab' : 'Questions'}</h2>
    <div>{c.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div></section>
  {relatedLinks.length > 0 && (
    <section class="section"><div class="wrap">
      <h2>{locale === 'id' ? 'Bacaan terkait' : 'Related reading'}</h2>
      <div class="card-list">{relatedLinks.map(link => (
        <a class="card related-card" href={link.href}><h3>{link.title}</h3><span class="arrow">›</span></a>
      ))}</div>
    </div></section>
  )}
  {sources.length > 0 && (
    <section class="section soft"><div class="wrap">
      <h2>{locale === 'id' ? 'Sumber & batasnya' : 'Sources & limits'}</h2>
      <p class="note">{locale === 'id' ? 'Halaman ini adalah panduan independen, bukan situs resmi. Informasi yang berubah (jam, tiket, acara) harus dikonfirmasikan melalui sumber resmi.' : 'This is an independent guide, not an official site. Changing details (hours, tickets, events) should be confirmed via official sources.'}</p>
      <ul class="source-list">{sources.map(s => <li><a href={s.href}>{s.label}</a></li>)}</ul>
    </div></section>
  )}
</article></main><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
</TopicLayout>
