---
/* Design philosophy: a persistent stage-side curtain and numbered scene spine turn the entire site into a sequential Wayang performance. */
interface Props {
  kind?: 'guide' | 'document';
}
const { kind = 'guide' } = Astro.props;
---

<aside class:list={['stage-rail', `stage-rail--${kind}`]} aria-label="Museum Wayang scene navigation">
  <a class="stage-rail__top" href={kind === 'guide' ? '#hero' : '#top'} aria-label="Museum Wayang Guide home"><img src="/logo.svg" alt="" /><i></i></a>
  {kind === 'guide' ? <nav class="stage-rail__scenes" aria-label="Guide scenes">
    <a href="#tentang" aria-label="Scene 01: history"><span>01</span></a>
    <a href="#koleksi" aria-label="Scene 02: collection"><span>02</span></a>
    <a href="#kunjungan" aria-label="Scene 03: visit planning"><span>03</span></a>
    <a href="#rute" aria-label="Scene 04: transport"><span>04</span></a>
    <a href="#membaca-wayang" aria-label="Scene 05: reading wayang"><span>05</span></a>
    <a href="#layanan" aria-label="Scene 06: practical services"><span>06</span></a>
    <a href="#tanya" aria-label="Scene 07: FAQ"><span>07</span></a>
  </nav> : <div class="stage-rail__scenes" aria-hidden="true"><span>01</span><span>02</span><span>03</span></div>}
  <div class="stage-rail__line"></div>
  <p>{kind === 'document' ? <><span data-lang-content="id">DOKUMEN</span><span data-lang-content="en">DOCUMENT</span></> : <><span data-lang-content="id">PANDUAN</span><span data-lang-content="en">GUIDE</span></>}</p>
  <div class="stage-rail__bottom"><i></i><span>KT</span></div>
</aside>
