---
/* Design philosophy: “Kulit Craft Workshop” layers a real Kota Tua facade behind a high-contrast puppet-screen narrative, making practical visit information feel like a sequence of scenes. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StageRail from '../components/StageRail.astro';
import GuideExpansion from '../components/GuideExpansion.astro';

const canonical = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const description = 'Panduan independen bilingual untuk Museum Wayang di Kota Tua Jakarta: sejarah, koleksi, jam kunjungan, akses, fasilitas, dan rute.';
const schema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Museum Wayang',
  alternateName: 'Wayang Museum',
  description,
  inLanguage: ['id', 'en'],
  url: canonical,
  image: '/assets/museum-wayang-exterior.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jl. Pintu Besar Utara No. 27, Pinangsia',
    addressLocality: 'Jakarta Barat',
    addressRegion: 'DKI Jakarta',
    postalCode: '11110',
    addressCountry: 'ID'
  },
  geo: { '@type': 'GeoCoordinates', latitude: -6.134611, longitude: 106.812714 },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '17:00' }],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.5', reviewCount: '5073', bestRating: '5', worstRating: '1' },
  sameAs: ['https://mitramuseumjakarta.id/wayang']
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Kapan Museum Wayang buka?', acceptedAnswer: { '@type': 'Answer', text: 'Informasi institusi mencantumkan Selasa–Minggu, pukul 09.00–17.00. Periksa kembali sebelum berangkat karena jadwal dapat berubah.' } },
    { '@type': 'Question', name: 'Berapa biaya masuknya?', acceptedAnswer: { '@type': 'Answer', text: 'Halaman institusi mencantumkan tarif dewasa Rp5.000, mahasiswa Rp3.000, dan anak-anak/pelajar Rp2.000. Harap periksa kembali karena tarif dapat berubah.' } },
    { '@type': 'Question', name: 'Bagaimana cara menuju Museum Wayang dengan kereta?', acceptedAnswer: { '@type': 'Answer', text: 'Stasiun Jakarta Kota disebut sebagai titik kereta terdekat; halaman institusi memperkirakan jarak jalan kaki sekitar 300 meter ke arah timur laut.' } },
    { '@type': 'Question', name: 'Bagaimana dari bandara?', acceptedAnswer: { '@type': 'Answer', text: 'Dari Soekarno–Hatta, kereta bandara atau bus bandara dapat digunakan untuk tahap awal ke pusat kota dan biasanya memerlukan perpindahan menuju Kota Tua. Periksa rute dan kondisi perjalanan secara langsung pada hari keberangkatan.' } },
    { '@type': 'Question', name: 'Apakah akses kursi roda tersedia?', acceptedAnswer: { '@type': 'Answer', text: 'Informasi institusi mencatat bahwa ramp di pintu masuk belum tersedia dan kursi roda tidak disewakan; akses alternatif menuju lantai dua disebut tersedia melalui pintu keluar pengunjung. Periksa kebutuhan aksesibilitas sebelum tiba.' } },
    { '@type': 'Question', name: 'Apakah situs ini merekomendasikan usaha tertentu?', acceptedAnswer: { '@type': 'Answer', text: 'Tidak. Museum Wayang Guide menjelaskan jenis layanan yang mungkin dibutuhkan pengunjung, tanpa memberi peringkat, afiliasi, atau rekomendasi komersial terhadap usaha tertentu.' } }
  ]
};
---

<BaseLayout title="Museum Wayang Guide — Kota Tua Jakarta" description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <SiteHeader home />
  <StageRail />
  <main>
    <section id="hero" class="hero" aria-labelledby="hero-title">
      <img class="hero-photo" src="/assets/museum-wayang-exterior.jpg" alt="Fasad putih Museum Wayang di Kota Tua Jakarta" />
      <div class="hero-scrim"></div>
      <img class="hero-pattern" src="/assets/museum-wayang-screen-pattern.png" alt="" />
      <img class="hero-brand-mark" src="/logo.svg" alt="" aria-hidden="true" />
      <div class="hero-stage" aria-hidden="true"><i class="hero-stage__arch"></i><i class="hero-stage__shadow hero-stage__shadow--one"></i><i class="hero-stage__shadow hero-stage__shadow--two"></i><span data-lang-content="id">LAYAR / 01</span><span data-lang-content="en">SCREEN / 01</span></div>
      <div class="hero-content">
        <p class="eyebrow"><span data-lang-content="id">KOTA TUA · JAKARTA BARAT</span><span data-lang-content="en">KOTA TUA · WEST JAKARTA</span></p>
        <h1 id="hero-title"><span data-lang-content="id">Masuk ke layar, temukan cerita.</span><span data-lang-content="en">Step into the screen, find the story.</span></h1>
        <p class="hero-intro"><span data-lang-content="id">Panduan independen untuk memahami Museum Wayang—ruang koleksi, sejarah bangunan, dan hal-hal praktis sebelum tiba.</span><span data-lang-content="en">An independent guide to Museum Wayang—its collections, the building’s layered past, and practical details for your visit.</span></p>
        <div class="hero-actions">
          <a class="button button-gold" href="#kunjungan"><span data-lang-content="id">Rencanakan kunjungan</span><span data-lang-content="en">Plan a visit</span></a>
          <a class="text-link" href="#koleksi"><span data-lang-content="id">Jelajahi koleksi →</span><span data-lang-content="en">Explore the collection →</span></a>
        </div>
      </div>
      <aside class="hero-facts" aria-label="Museum summary">
        <div><span data-lang-content="id">JAM RUJUKAN</span><span data-lang-content="en">REFERENCE HOURS</span><strong>Tue–Sun · 09:00–17:00</strong></div>
        <div><span data-lang-content="id">ALAMAT</span><span data-lang-content="en">ADDRESS</span><strong>Jl. Pintu Besar Utara No. 27</strong></div>
        <div><span data-lang-content="id">TIPE</span><span data-lang-content="en">TYPE</span><strong><span data-lang-content="id">Wayang & warisan budaya</span><span data-lang-content="en">Wayang & cultural heritage</span></strong></div>
      </aside>
    </section>

    <section class="index-ribbon" aria-label="Guide chapters">
      <p><span>01</span><a href="#tentang"><span data-lang-content="id">Latar & sejarah</span><span data-lang-content="en">Context & history</span></a></p>
      <p><span>02</span><a href="#koleksi"><span data-lang-content="id">Koleksi</span><span data-lang-content="en">Collection</span></a></p>
      <p><span>03</span><a href="#kunjungan"><span data-lang-content="id">Kunjungan</span><span data-lang-content="en">Visit</span></a></p>
      <p><span>04</span><a href="#rute"><span data-lang-content="id">Transportasi</span><span data-lang-content="en">Getting here</span></a></p>
    </section>

    <section id="tentang" class="section scene-section history-section motif-arch">
      <div class="scene-label"><img src="/assets/museum-wayang-scene-seal.png" alt="" /><span data-lang-content="id">ADEGAN 01</span><span data-lang-content="en">SCENE 01</span></div>
      <div class="section-heading">
        <p class="eyebrow"><span data-lang-content="id">BACA BANGUNANNYA</span><span data-lang-content="en">READ THE BUILDING</span></p>
        <h2><span data-lang-content="id">Satu alamat, beberapa kehidupan.</span><span data-lang-content="en">One address, several lives.</span></h2>
      </div>
      <div class="history-copy prose">
        <p data-lang-content="id">Museum Wayang berdiri di tepi Fatahillah Square, di dalam bangunan yang riwayatnya mendahului fungsi museumnya. Kronologi yang dipublikasikan lembaga museum menelusuri lokasi ini dari gereja tahun 1640, pembangunan kembali sebagai <em>de Nieuw Holandsche Kerk</em> pada 1732, menjadi Oude Bataviasche Museum pada 1939, hingga peresmian sebagai Museum Wayang pada 1975.</p>
        <p data-lang-content="en">Museum Wayang stands beside Fatahillah Square in a building whose story predates its museum role. The institution’s published timeline traces the site from a church in 1640, its 1732 rebuilding as <em>de Nieuw Holandsche Kerk</em>, its use as the Oude Bataviasche Museum in 1939, and its inauguration as Museum Wayang in 1975.</p>
        <p data-lang-content="id">Itulah sebabnya kunjungan terbaik tidak hanya berhenti pada vitrin. Luangkan waktu untuk membaca fasad, melihat hubungan museum dengan alun-alun, lalu gunakan koleksi sebagai jalan masuk ke beragam tradisi pewayangan di Indonesia.</p>
        <p data-lang-content="en">That is why a good visit does not stop at the display cases. Take time to read the facade, notice the museum’s relationship to the square, and let the collection open a route into Indonesia’s many wayang traditions.</p>
      </div>
      <ol class="timeline" aria-label="Building timeline">
        <li><time>1640</time><span data-lang-content="id">Sebuah gereja didirikan di lokasi ini.</span><span data-lang-content="en">A church was established on this site.</span></li>
        <li><time>1732</time><span data-lang-content="id">Bangunan diperbaiki dan dinamai de Nieuw Holandsche Kerk.</span><span data-lang-content="en">The building was repaired and named de Nieuw Holandsche Kerk.</span></li>
        <li><time>1939</time><span data-lang-content="id">Berfungsi sebagai Oude Bataviasche Museum.</span><span data-lang-content="en">It became the Oude Bataviasche Museum.</span></li>
        <li><time>1975</time><span data-lang-content="id">Diresmikan sebagai Museum Wayang.</span><span data-lang-content="en">It was inaugurated as Museum Wayang.</span></li>
      </ol>
    </section>

    <section id="koleksi" class="section collection-section motif-shadow-frame">
      <div class="collection-media"><img src="/assets/museum-wayang-kulit.jpg" alt="Siluet wayang kulit di dalam Museum Wayang" /><p><span data-lang-content="id">Wayang kulit di Museum Wayang. Foto: Amelia guo, CC BY 3.0.</span><span data-lang-content="en">Wayang kulit at Museum Wayang. Photo: Amelia guo, CC BY 3.0.</span></p></div>
      <div class="collection-content">
        <p class="eyebrow"><span data-lang-content="id">ADEGAN 02 · KOLEKSI</span><span data-lang-content="en">SCENE 02 · COLLECTION</span></p>
        <h2><span data-lang-content="id">Lebih dari satu bentuk wayang.</span><span data-lang-content="en">More than one form of wayang.</span></h2>
        <p data-lang-content="id">Wayang bukan satu benda tunggal. Dalam konteks pertunjukan, kata ini dapat merujuk pada bentuk boneka maupun penari manusia. Museum ini mempertemukan wayang kulit, bentuk-bentuk boneka lain, serta objek dari berbagai wilayah Indonesia dan beberapa negara lain. Halaman institusi mencantumkan sekitar 5.373 koleksi.</p>
        <p data-lang-content="en">Wayang is not a single object. In performance, the word can refer to puppets as well as human dancers. The museum brings together wayang kulit, other puppet forms, and objects from regions across Indonesia and several other countries. Its institutional page lists approximately 5,373 collection items.</p>
        <div class="collection-notes">
          <article><strong><span data-lang-content="id">Wayang kulit</span><span data-lang-content="en">Wayang kulit / shadow puppets</span></strong><p data-lang-content="id">Boneka kulit yang dikenal melalui permainan cahaya dan bayangan.</p><p data-lang-content="en">Leather puppets known through their play of light and shadow.</p></article>
          <article><strong><span data-lang-content="id">Lintas wilayah</span><span data-lang-content="en">Across regions</span></strong><p data-lang-content="id">Gunakan label asal untuk melihat perbedaan bahan, bentuk, dan cerita.</p><p data-lang-content="en">Use origin labels to notice differences in material, form, and stories.</p></article>
          <article><strong><span data-lang-content="id">Ruang pertunjukan</span><span data-lang-content="en">Performance space</span></strong><p data-lang-content="id">Tanyakan di lokasi tentang program atau demonstrasi yang sedang berlangsung.</p><p data-lang-content="en">Ask on site about any current programmes or demonstrations.</p></article>
        </div>
      </div>
    </section>

    <section id="kunjungan" class="section visit-section motif-perforation">
      <div class="scene-label"><img src="/assets/museum-wayang-scene-seal.png" alt="" /><span data-lang-content="id">ADEGAN 03</span><span data-lang-content="en">SCENE 03</span></div>
      <div class="visit-intro">
        <p class="eyebrow"><span data-lang-content="id">SEBELUM MASUK</span><span data-lang-content="en">BEFORE YOU ENTER</span></p>
        <h2><span data-lang-content="id">Rencanakan pelan-pelan.</span><span data-lang-content="en">Plan it at an unhurried pace.</span></h2>
        <p data-lang-content="id">Informasi di bawah adalah ringkasan dari halaman institusi Museum Wayang. Jadwal, harga, akses, dan fasilitas dapat berubah; periksa kanal museum sebelum berangkat.</p>
        <p data-lang-content="en">The details below summarize Museum Wayang’s institutional page. Hours, fees, access, and facilities may change; check museum channels before you travel.</p>
      </div>
      <div class="practical-grid">
        <article><span class="card-number">01</span><h3><span data-lang-content="id">Jam & waktu terbaik</span><span data-lang-content="en">Hours & best timing</span></h3><p data-lang-content="id">Rujukan: Selasa–Minggu, 09.00–17.00. Datang lebih awal memberi waktu untuk museum dan suasana Kota Tua sebelum panas dan keramaian meningkat.</p><p data-lang-content="en">Reference hours: Tue–Sun, 09:00–17:00. Arriving earlier leaves time for the museum and Kota Tua before heat and crowds build.</p></article>
        <article><span class="card-number">02</span><h3><span data-lang-content="id">Tiket / biaya</span><span data-lang-content="en">Tickets / cost</span></h3><p data-lang-content="id">Rujukan tarif: dewasa Rp5.000; mahasiswa Rp3.000; anak-anak/pelajar Rp2.000. Siapkan metode pembayaran yang berlaku dan konfirmasi di loket.</p><p data-lang-content="en">Reference fees: adults Rp5,000; university students Rp3,000; children/students Rp2,000. Bring an accepted payment method and confirm at the ticket desk.</p></article>
        <article><span class="card-number">03</span><h3><span data-lang-content="id">Durasi kunjungan</span><span data-lang-content="en">Suggested duration</span></h3><p data-lang-content="id">Sisihkan sekitar 60–90 menit untuk membaca label tanpa terburu-buru. Tambahkan waktu bila ingin melanjutkan berjalan kaki di Fatahillah Square.</p><p data-lang-content="en">Set aside about 60–90 minutes to read labels without rushing. Add time if you plan to continue on foot around Fatahillah Square.</p></article>
        <article><span class="card-number">04</span><h3><span data-lang-content="id">Fasilitas & akses</span><span data-lang-content="en">Facilities & access</span></h3><p data-lang-content="id">Halaman institusi mencantumkan toilet, musholla, AC, ruang pagelaran, dan pemandu. Ramp masuk belum tersedia; hubungi museum lebih dulu untuk kebutuhan mobilitas khusus.</p><p data-lang-content="en">The institution lists toilets, a prayer room, air-conditioning, a performance room, and guides. An entrance ramp is not listed; contact the museum ahead for specific mobility needs.</p></article>
      </div>
    </section>

    <section id="rute" class="section route-section motif-arch">
      <div class="route-heading"><p class="eyebrow"><span data-lang-content="id">ADEGAN 04 · RUTE</span><span data-lang-content="en">SCENE 04 · GETTING HERE</span></p><h2><span data-lang-content="id">Datang dengan kereta, bus, atau perjalanan darat.</span><span data-lang-content="en">Arrive by rail, bus, or road.</span></h2></div>
      <div class="route-layout">
        <div class="route-cards">
          <article><h3><span>01</span><span data-lang-content="id">Dari bandara</span><span data-lang-content="en">From the airport</span></h3><p data-lang-content="id">Dari Bandara Soekarno–Hatta, rencanakan perjalanan menuju kawasan Jakarta Kota melalui kereta bandara, layanan bus, atau kendaraan darat. Sisakan waktu ekstra untuk perpindahan dan kondisi lalu lintas.</p><p data-lang-content="en">From Soekarno–Hatta Airport, plan toward the Jakarta Kota area by airport rail, bus service, or road transport. Allow extra time for transfers and traffic conditions.</p></article>
          <article><h3><span>02</span><span data-lang-content="id">Kereta & bus</span><span data-lang-content="en">Rail & bus</span></h3><p data-lang-content="id">Stasiun Jakarta Kota disebut berjarak sekitar 300 m berjalan kaki ke arah timur laut. Halte Jakarta Kota dan Kali Besar Barat adalah rujukan bus yang dicantumkan oleh institusi; cek rute aktif sebelum berangkat.</p><p data-lang-content="en">Jakarta Kota Station is listed at roughly a 300 m northeast walk. Jakarta Kota and Kali Besar Barat stops are institution-listed bus references; check active routes before travelling.</p></article>
          <article><h3><span>03</span><span data-lang-content="id">Taksi & kendaraan daring</span><span data-lang-content="en">Taxi & ride-hailing</span></h3><p data-lang-content="id">Gunakan titik turun di sekitar Jalan Pintu Besar Utara dan lanjutkan sesuai pengaturan lalu lintas kawasan. Pilih titik jemput setelah keluar dari area ramai agar perjalanan pulang lebih jelas.</p><p data-lang-content="en">Use a drop-off point near Jalan Pintu Besar Utara and continue according to local traffic arrangements. Pick a meeting point after leaving crowded areas for a clearer return trip.</p></article>
          <article><h3><span>04</span><span data-lang-content="id">Parkir</span><span data-lang-content="en">Parking</span></h3><p data-lang-content="id">Rujukan institusi menyebut parkir Jalan Cengkeh dan kawasan Kali Besar. Tempat dapat terbatas pada akhir pekan; pertimbangkan transportasi umum dan konfirmasi kondisi setempat.</p><p data-lang-content="en">The institution cites Jalan Cengkeh parking and the Kali Besar area. Capacity may be limited at weekends; consider public transport and confirm local conditions.</p></article>
        </div>
        <div class="map-wrap"><iframe title="Lokasi Museum Wayang di Google Maps" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.968545408292!2d106.80973051244983!3d-6.134928693826295!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e6a1dff48f259ff%3A0xfeb6bfd7e15db853!2z5pyo5YG25Y2a54mp6aaG!5e0!3m2!1sid!2sid!4v1787189535362!5m2!1sid!2sid" width="600" height="450" style="border:0" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
      </div>
    </section>

    <section class="section surrounding-section motif-shadow-frame">
      <div class="surrounding-head"><p class="eyebrow"><span data-lang-content="id">DI SEKITAR KOTA TUA</span><span data-lang-content="en">AROUND KOTA TUA</span></p><h2><span data-lang-content="id">Bangun rute yang tidak tergesa-gesa.</span><span data-lang-content="en">Build an unhurried route.</span></h2></div>
      <div class="surrounding-grid">
        <article><h3><span data-lang-content="id">Tempat terdekat</span><span data-lang-content="en">Nearby sights</span></h3><p data-lang-content="id">Fatahillah Square berada di depan museum. Untuk memperpanjang konteks sejarah, pertimbangkan museum sejarah, seni-rupa/keramik, atau tepian Kali Besar sebagai tujuan berjalan kaki—periksa jam buka masing-masing.</p><p data-lang-content="en">Fatahillah Square is directly outside. To extend the historical context, consider the history museum, fine art/ceramics museum, or Kali Besar waterfront on foot—check each venue’s opening hours.</p></article>
        <article><h3><span data-lang-content="id">Makan & minum</span><span data-lang-content="en">Food & drink</span></h3><p data-lang-content="id">Kawasan sekitar menyediakan pilihan warung, kafe, dan restoran dalam berbagai rentang harga. Pilih berdasarkan kebutuhan diet, kebersihan, jam buka, dan jarak jalan kaki; panduan ini tidak merekomendasikan usaha tertentu.</p><p data-lang-content="en">The area has food stalls, cafés, and restaurants at different price points. Choose based on dietary needs, hygiene, opening hours, and walking distance; this guide does not endorse particular businesses.</p></article>
        <article><h3><span data-lang-content="id">Kebutuhan harian</span><span data-lang-content="en">Everyday needs</span></h3><p data-lang-content="id">Toilet tersedia menurut halaman museum. Untuk ATM, toko kebutuhan ringan, penginapan, bahan bakar, atau pengisian kendaraan listrik, rencanakan dari peta langsung sesuai arah perjalanan dan jenis kendaraan.</p><p data-lang-content="en">Toilets are listed by the museum. For cash access, convenience goods, accommodation, fuel, or EV charging, plan directly from a map according to your route and vehicle type.</p></article>
      </div>
    </section>

    <GuideExpansion />

    <section class="gallery-section" aria-label="Museum Wayang photographs">
      <figure class="gallery-large"><img src="/assets/museum-wayang-facade.jpg" alt="Tampak bangunan Museum Wayang di Jakarta" /><figcaption><span data-lang-content="id">Museum Wayang, Jakarta. Foto: Chainwit., CC BY 4.0.</span><span data-lang-content="en">Museum Wayang, Jakarta. Photo: Chainwit., CC BY 4.0.</span></figcaption></figure>
      <div class="gallery-aside"><img src="/assets/museum-wayang-screen-pattern.png" alt="" /><p><span data-lang-content="id">Motif visual situs terinspirasi oleh layar, cahaya, dan kerja potong pada wayang kulit; ini adalah ilustrasi dekoratif, bukan dokumentasi koleksi.</span><span data-lang-content="en">The site’s visual motif draws from the screen, light, and cutwork of wayang kulit; it is a decorative illustration, not collection documentation.</span></p></div>
    </section>

    <section id="tanya" class="section faq-section motif-perforation">
      <div class="faq-heading"><p class="eyebrow"><span data-lang-content="id">ADEGAN 05 · TANYA JAWAB</span><span data-lang-content="en">SCENE 05 · FAQ</span></p><h2><span data-lang-content="id">Pertanyaan sebelum berkunjung.</span><span data-lang-content="en">Questions before you go.</span></h2></div>
      <div class="faq-list">
        <details><summary><span data-lang-content="id">Kapan museum buka?</span><span data-lang-content="en">When is the museum open?</span></summary><p data-lang-content="id">Halaman institusi mencantumkan Selasa–Minggu, 09.00–17.00. Karena jadwal dapat berubah, konfirmasi kembali sebelum berangkat.</p><p data-lang-content="en">The institutional page lists Tue–Sun, 09:00–17:00. As schedules can change, confirm before travelling.</p></details>
        <details><summary><span data-lang-content="id">Berapa biaya masuknya?</span><span data-lang-content="en">What does admission cost?</span></summary><p data-lang-content="id">Rujukan tarifnya adalah Rp5.000 untuk dewasa, Rp3.000 untuk mahasiswa, dan Rp2.000 untuk anak-anak/pelajar. Periksa kembali di loket atau kanal museum.</p><p data-lang-content="en">The reference fees are Rp5,000 for adults, Rp3,000 for university students, and Rp2,000 for children/students. Recheck at the desk or museum channel.</p></details>
        <details><summary><span data-lang-content="id">Apakah bisa datang dengan kereta?</span><span data-lang-content="en">Can I arrive by train?</span></summary><p data-lang-content="id">Bisa. Stasiun Jakarta Kota disebut sekitar 300 meter berjalan kaki ke arah timur laut. Gunakan peta langsung untuk rute berjalan kaki terkini.</p><p data-lang-content="en">Yes. Jakarta Kota Station is listed at an approximately 300 m northeast walk. Use a live map for the current walking route.</p></details>
        <details><summary><span data-lang-content="id">Bagaimana aksesibilitasnya?</span><span data-lang-content="en">What about accessibility?</span></summary><p data-lang-content="id">Ramp di pintu masuk belum tersedia menurut informasi institusi dan tidak ada peminjaman kursi roda. Hubungi museum terlebih dahulu untuk kebutuhan akses khusus.</p><p data-lang-content="en">The institutional information says an entrance ramp is not available and wheelchairs are not loaned. Contact the museum in advance for specific access needs.</p></details>
